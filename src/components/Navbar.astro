---
const navItems = [
  { name: "Home", href: "/" },
  { name: "About", href: "/about" },
  { name: "Blog", href: "/blog" },
  // { name: "Proj", href: "/proj" },
  // { name: "Design", href: "/design" },
  { name: "Music", href: "/music" },
  // { name: "Film", href: "/film" },
  { name: "W*rk", href: "/work" },
  // { name: "Books", href: "/books" },
];
---

<header class="fixed top-0 left-0 w-full z-50">
  {/* Subtle gradient for readability */}
  <div
    class="absolute inset-0 bg-linear-to-b from-black/40 to-transparent pointer-events-none"
  >
  </div>

  <div class="relative mx-auto px-6 md:px-8">
    <div class="flex items-center justify-between py-6 font-neue">
      {/* Left: Site Name */}
      <a href="/" class="text-base tracking-wide">soupologist</a>

      {/* Desktop Nav */}
      <nav class="hidden md:flex items-center gap-8">
        {
          navItems.map((item) => (
            <a href={item.href} class="text-sm tracking-wide">
              {item.name}
            </a>
          ))
        }
      </nav>

      {/* Mobile Menu Button */}
      <button data-nav-toggle class="md:hidden text-sm">Menu</button>
    </div>
  </div>

  {/* Mobile Menu */}
  <div data-nav-menu class="hidden md:hidden bg-black/80 backdrop-blur-md">
    <div class="mx-auto px-6 pb-6 flex flex-col gap-4">
      {
        navItems.map((item) => (
          <a href={item.href} class="text-base">
            {item.name}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const menu = document.querySelector<HTMLDivElement>("[data-nav-menu]");

  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.textContent = open ? "Close" : "Menu";
  });
</script>
