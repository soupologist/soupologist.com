---
const links = [
  { label: "w*rk", href: "/work" },
  { label: "blog", href: "/blog" },
  { label: "music", href: "/music" },
  // { label: "film", href: "/film" },
  { label: "about", href: "/about" },
];

// match nested routes too, so /blog/some-post still marks "blog"
const path = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header
  class="fixed left-0 top-0 z-50 flex w-full items-center justify-between px-6 py-5 font-mono md:px-10 md:py-7"
>
  <a href="/" class="text-sm tracking-[-0.04em]">soupologist</a>

  <nav class="flex items-center gap-5 text-xs">
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class:list={[
            "transition-opacity hover:opacity-50",
            isActive(link.href) && "opacity-50",
          ]}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
