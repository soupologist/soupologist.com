---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allEntries = await getCollection("music");
const entries = allEntries
  .filter((entry) => entry.data.published)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  );
---

<BaseLayout title="music">
  <main class="px-4 md:px-6">
    <div class="pt-20 md:pt-24"></div>

    <section
      class="mx-auto max-w-3xl border border-(--border) bg-(--surface) px-5 py-6 md:px-7 md:py-8"
    >
      {/* Header */}
      <div class="mb-8 border-b border-(--border) pb-4">
        <p class="mb-2 text-[10px] uppercase tracking-[0.25em] text-foreground opacity-60">
          archive
        </p>

        <h1 class="text-2xl md:text-3xl font-head tracking-widest leading-none">
          music
        </h1>

        <p class="mt-4 text-sm leading-relaxed text-(--text) opacity-55">
          I want to be more accountable in terms of my consistency in music
          production. So this place is an area for me to put the tracks and
          snippets I make along with some background.
        </p>
      </div>

      {/* Entries */}
      <div class="divide-y divide-(--border)">
        {
          entries.map((entry, index) => (
            <a href={`/music/${entry.id}`}>
              <article class="group grid grid-cols-[28px_1fr_auto] gap-4 py-5 transition-all duration-200 hover:translate-x-0.5">
                {/* Number */}
                <div class="pt-0.5 text-xs text-foreground opacity-35 group-hover:opacity-80 transition-opacity">
                  {String(index + 1).padStart(2, "0")}
                </div>

                {/* Main */}
                <div>
                  <h2 class="text-lg md:text-xl tracking-tight text-(--text) transition-colors group-hover:text-foreground">
                    {entry.data.title}
                  </h2>

                  <div class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-(--text) opacity-45">
                    <span>{entry.data.date}</span>
                    {entry.data.location && <span>{entry.data.location}</span>}
                    {entry.data.tags?.length > 0 && (
                      <span>{entry.data.tags.join(", ")}</span>
                    )}
                  </div>
                </div>

                {/* Duration */}
                <div class="pt-1 text-xs text-(--text) opacity-45 tabular-nums">
                  {entry.data.duration}
                </div>
              </article>
            </a>
          ))
        }
      </div>
    </section>

    <div class="h-20 md:h-24"></div>
  </main>
</BaseLayout>
