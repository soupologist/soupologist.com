---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

// one page per tier list. entries are revealed one at a time in the order they
// were ranked; the board below fills up as you go, or "skip to final" shows it
// all at once. without JS the whole board just renders (cards stay hidden)
export async function getStaticPaths() {
  const lists = await getCollection("tierlists");
  return lists.map((list) => ({ params: { list: list.id }, props: { list } }));
}

const { list } = Astro.props;
const { title, blurb, tiers } = list.data;

const entries = (
  await getCollection("tieritems", (item) => item.id.startsWith(`${list.id}/`))
).sort(
  (a, b) =>
    a.data.date.getTime() - b.data.date.getTime() || a.id.localeCompare(b.id),
);

for (const entry of entries) {
  if (!tiers.includes(entry.data.tier)) {
    throw new Error(
      `tiers/${entry.id}: tier "${entry.data.tier}" isn't one of ${tiers.join(", ")}`,
    );
  }
}

const items = await Promise.all(
  entries.map(async (entry, step) => ({
    ...entry.data,
    step,
    Content: (await render(entry)).Content,
  })),
);

// classic tiermaker pastels, top to bottom; lists with more tiers keep going
// round the wheel
const tierColors = [
  "#ff7f7f", "#ffbf7f", "#ffdf7f", "#ffff7f", "#bfff7f", "#7fff7f",
  "#7fffff", "#7fbfff", "#7f7fff", "#ff7fff", "#bf7fbf",
];
const tierColor = (index: number) => tierColors[Math.min(index, tierColors.length - 1)];
---

<BaseLayout title={title}>
  <main class="min-h-screen bg-[#070707] text-foreground">
    <article
      data-tierlist
      data-total={items.length}
      class="mx-auto max-w-3xl px-6 pb-32 pt-36 md:px-10 md:pt-44"
    >
      <a
        href="/tiers"
        class="mb-6 inline-block text-xs uppercase tracking-[0.15em] text-(--muted) transition-colors hover:text-[#ffb52e]"
        >← tiers</a
      >
      <h1 class="mb-4 text-6xl tracking-loose sm:text-8xl">{title}</h1>
      {
        blurb && (
          <p class="mb-4 text-[15px] leading-[1.85] text-(--text)/90 md:text-[16px]">
            {blurb}
          </p>
        )
      }
      <p class="mb-16 text-xs uppercase tracking-[0.15em] text-(--muted)">
        {items.length} ranked
      </p>

      {
        items.length > 0 && (
          <>
            {/* detail card for one entry at a time — shown by the script */}
            <section data-stage hidden class="mb-16">
              {items.map((item) => (
                <div data-card={item.step} hidden>
                  {item.photos.length > 0 && (
                    <div class="-mx-6 mb-8 flex snap-x gap-3 overflow-x-auto px-6 md:mx-0 md:px-0">
                      {item.photos.map((photo, i) => (
                        <Image
                          src={photo}
                          alt={`${item.name}, photo ${i + 1}`}
                          width={720}
                          class="h-64 w-auto max-w-none shrink-0 snap-start border border-(--border) object-cover md:h-80"
                        />
                      ))}
                    </div>
                  )}

                  <div class="mb-6 flex items-start gap-5">
                    <span
                      class="flex h-14 w-14 shrink-0 items-center justify-center text-2xl text-[#1a1a17]"
                      style={`background:${tierColor(tiers.indexOf(item.tier))}`}
                    >
                      {item.tier}
                    </span>
                    <div>
                      <h2 class="text-3xl leading-tight md:text-4xl">
                        {item.name}
                      </h2>
                      {item.place && (
                        <p class="mt-1 text-xs uppercase tracking-[0.15em] text-(--muted)">
                          {item.place}
                        </p>
                      )}
                    </div>
                  </div>

                  <div class="space-y-5 text-[15px] leading-[1.85] text-(--text)/90 md:text-[16px] [&_a]:underline [&_a]:underline-offset-4">
                    <item.Content />
                  </div>
                </div>
              ))}

              {/* end of the reveal: what the final card area says */}
              <div data-card="final" hidden>
                <h2 class="text-3xl md:text-4xl">the full list</h2>
                <p class="mt-2 text-[15px] text-(--muted)">
                  tap any entry on the board to read about it.
                </p>
              </div>

              <nav class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-xs uppercase tracking-[0.15em]">
                <button data-action="prev" class="text-(--muted) transition-colors hover:text-[#ffb52e] disabled:opacity-30 disabled:hover:text-(--muted)">
                  ← prev
                </button>
                <span data-counter class="tabular-nums text-(--muted)"></span>
                <button data-action="next" class="text-foreground transition-colors hover:text-[#ffb52e] disabled:opacity-30 disabled:hover:text-foreground">
                  next →
                </button>
                <button data-action="final" class="ml-auto text-(--muted) transition-colors hover:text-[#ffb52e]">
                  skip to final
                </button>
                <button data-action="replay" hidden class="ml-auto text-(--muted) transition-colors hover:text-[#ffb52e]">
                  ↺ start over
                </button>
              </nav>
            </section>
          </>
        )
      }

      {/* the board, tiermaker-style — every tile is rendered, the script
          hides the ones not revealed yet */}
      <div class="border border-black bg-black">
        {tiers.map((tier, tierIndex) => (
          <div class="flex min-h-20 border-b border-black last:border-b-0 md:min-h-24">
            <div
              class="flex w-20 shrink-0 items-center justify-center p-2 text-center text-lg break-words text-[#1a1a17] md:w-28 md:text-xl"
              style={`background:${tierColor(tierIndex)}`}
            >
              {tier}
            </div>
            <div
              data-row
              class="flex flex-1 flex-wrap content-start bg-[#1a1a17] transition-colors data-[over]:bg-[#2c2c28]"
            >
              {items
                .filter((item) => item.tier === tier)
                .map((item) => (
                  <button
                    data-chip={item.step}
                    title={item.place ? `${item.name} — ${item.place}` : item.name}
                    class="relative h-20 min-w-20 cursor-grab touch-none overflow-hidden outline-offset-[-3px] transition-opacity select-none hover:opacity-80 active:cursor-grabbing data-[current]:outline-3 data-[current]:outline-white md:h-24 md:min-w-24"
                  >
                    {item.logo ? (
                      // logos keep their shape — full tile height, natural width
                      <Image
                        src={item.logo}
                        alt={item.name}
                        height={192}
                        draggable="false"
                        class="h-full w-auto"
                      />
                    ) : item.photos[0] ? (
                      <Image
                        src={item.photos[0]}
                        alt={item.name}
                        width={192}
                        height={192}
                        draggable="false"
                        class="h-full w-full object-cover"
                      />
                    ) : (
                      <span class="flex h-full w-full items-center justify-center bg-[#2c2c28] p-2 text-center text-xs leading-tight text-[#e8e5dd]">
                        {item.name}
                      </span>
                    )}
                  </button>
                ))}
            </div>
          </div>
        ))}
      </div>
    </article>

    {/* the board looks draggable. it isn't. (gif from tenor, converted to an
        animated webp at half the size; lazy so it only loads for draggers) */}
    <dialog
      data-nuh-uh
      class="m-auto max-w-[min(28rem,calc(100vw-2rem))] border border-(--border) bg-[#070707] p-0 text-foreground backdrop:bg-black/75"
    >
      <div class="p-4">
        <img
          src="/images/kanye-nuh-uh.webp"
          width="374"
          height="211"
          loading="lazy"
          alt="kanye west: excuse me, was you saying something? uh-uh, you can't tell me nothing"
          class="mb-4 w-full"
        />
        <p class="mb-5 text-sm leading-relaxed">
          excuse me, was you saying something?<br />
          uh-uh, you can't tell me nothing.
        </p>
        <form method="dialog" class="flex justify-end">
          <button class="text-xs uppercase tracking-[0.15em] text-(--muted) transition-colors hover:text-[#ffb52e]">
            my bad
          </button>
        </form>
      </div>
    </dialog>
  </main>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>("[data-tierlist]");
  const stage = root?.querySelector<HTMLElement>("[data-stage]");

  if (root && stage) {
    const total = Number(root.dataset.total);
    const cards = [...stage.querySelectorAll<HTMLElement>("[data-card]")];
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-chip]")];
    const counter = stage.querySelector<HTMLElement>("[data-counter]")!;
    const button = (action: string) =>
      stage.querySelector<HTMLButtonElement>(`[data-action="${action}"]`)!;

    // `revealed` = how many entries are on the board; `shown` = whose card is
    // open (null on the final screen until a chip is picked)
    let revealed = 1;
    let shown: number | null = 0;

    const render = () => {
      const done = revealed >= total && shown === null;
      cards.forEach((card) => {
        card.hidden =
          card.dataset.card === "final" ? !done : Number(card.dataset.card) !== shown;
      });
      chips.forEach((chip) => {
        const step = Number(chip.dataset.chip);
        chip.hidden = step >= revealed;
        chip.toggleAttribute("data-current", step === shown);
      });

      const finished = revealed >= total;
      counter.textContent = done ? `${total} / ${total}` : `${(shown ?? 0) + 1} / ${total}`;
      button("prev").disabled = !finished && revealed <= 1;
      button("next").disabled = finished && (shown === null || shown >= total - 1);
      button("final").hidden = finished;
      button("replay").hidden = !finished;
    };

    const go = (action: string) => {
      const finished = revealed >= total;
      if (action === "next") {
        if (!finished) {
          revealed += 1;
          shown = revealed - 1;
        } else if (shown !== null && shown < total - 1) {
          shown += 1;
        } else return;
      } else if (action === "prev") {
        if (!finished) {
          if (revealed <= 1) return;
          revealed -= 1;
          shown = revealed - 1;
        } else {
          shown = shown === null ? total - 1 : Math.max(0, shown - 1);
        }
      } else if (action === "final") {
        revealed = total;
        shown = null;
      } else if (action === "replay") {
        revealed = 1;
        shown = 0;
      }
      render();
    };

    stage.addEventListener("click", (event) => {
      const action = (event.target as HTMLElement).closest<HTMLElement>("[data-action]")?.dataset.action;
      if (action) go(action);
    });

    // tiles can be picked up and dragged around like a real tier maker — but
    // on release they spring back home and kanye explains why
    const nuhUh = document.querySelector<HTMLDialogElement>("[data-nuh-uh]");
    let draggedAt = 0;

    nuhUh?.addEventListener("click", (event) => {
      if (event.target === nuhUh) nuhUh.close(); // backdrop
    });

    chips.forEach((chip) =>
      chip.addEventListener("pointerdown", (down) => {
        if (down.button !== 0) return;
        let dragging = false;
        let over: HTMLElement | null = null;

        const move = (event: PointerEvent) => {
          const dx = event.clientX - down.clientX;
          const dy = event.clientY - down.clientY;
          if (!dragging && Math.hypot(dx, dy) < 6) return;
          if (!dragging) {
            dragging = true;
            // let elementFromPoint see through the tile to the row beneath
            chip.style.pointerEvents = "none";
            chip.style.zIndex = "20";
            chip.style.transition = "none";
            chip.style.boxShadow = "0 12px 30px rgba(0,0,0,0.6)";
          }
          chip.style.transform = `translate(${dx}px, ${dy}px) scale(1.08) rotate(-3deg)`;

          const row = document
            .elementFromPoint(event.clientX, event.clientY)
            ?.closest<HTMLElement>("[data-row]") ?? null;
          if (row !== over) {
            over?.removeAttribute("data-over");
            row?.setAttribute("data-over", "");
            over = row;
          }
        };

        const up = () => {
          window.removeEventListener("pointermove", move);
          window.removeEventListener("pointerup", up);
          window.removeEventListener("pointercancel", up);
          over?.removeAttribute("data-over");
          if (!dragging) return;

          draggedAt = performance.now();
          chip.style.transition = "transform 350ms cubic-bezier(0.3, 1.5, 0.5, 1), box-shadow 350ms";
          chip.style.transform = "";
          chip.style.boxShadow = "";
          setTimeout(() => (chip.style.cssText = ""), 350);
          if (nuhUh && !nuhUh.open) nuhUh.showModal();
        };

        window.addEventListener("pointermove", move);
        window.addEventListener("pointerup", up);
        window.addEventListener("pointercancel", up);
      }),
    );

    // once everything's out, the board doubles as a picker
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        if (performance.now() - draggedAt < 400) return; // that was a drag
        shown = Number(chip.dataset.chip);
        render();
        stage.scrollIntoView({ behavior: "smooth", block: "start" });
      }),
    );

    document.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") go("next");
      if (event.key === "ArrowLeft") go("prev");
    });

    stage.hidden = false;
    render();
  }
</script>
