---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

// one page per tier list, read by scrolling: entries stack in the order they
// were ranked and the sticky board fills in as each one scrolls past (and
// empties again on the way back up). "show full list" fills it all at once.
// without JS the board is just shown complete
export async function getStaticPaths() {
  const lists = await getCollection("tierlists");
  return lists.map((list) => ({ params: { list: list.id }, props: { list } }));
}

const { list } = Astro.props;
const { title, blurb, tiers } = list.data;

const entries = (
  await getCollection("tieritems", (item) => item.id.startsWith(`${list.id}/`))
).sort(
  (a, b) =>
    a.data.date.getTime() - b.data.date.getTime() || a.id.localeCompare(b.id),
);

for (const entry of entries) {
  if (!tiers.includes(entry.data.tier)) {
    throw new Error(
      `tiers/${entry.id}: tier "${entry.data.tier}" isn't one of ${tiers.join(", ")}`,
    );
  }
}

const items = await Promise.all(
  entries.map(async (entry, step) => ({
    ...entry.data,
    step,
    Content: (await render(entry)).Content,
  })),
);

// classic tiermaker pastels, top to bottom; lists with more tiers keep going
// round the wheel
const tierColors = [
  "#ff7f7f", "#ffbf7f", "#ffdf7f", "#ffff7f", "#bfff7f", "#7fff7f",
  "#7fffff", "#7fbfff", "#7f7fff", "#ff7fff", "#bf7fbf",
];
const tierColor = (index: number) => tierColors[Math.min(index, tierColors.length - 1)];
---

<BaseLayout title={title}>
  <main class="min-h-screen bg-[#070707] text-foreground">
    <div
      data-tierlist
      class="mx-auto grid max-w-6xl gap-x-16 px-6 pt-28 md:px-10 md:pt-36 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]"
    >
      <header class="mb-8 lg:col-span-2 lg:mb-12">
        <a
          href="/tiers"
          class="mb-3 inline-block text-xs uppercase tracking-[0.15em] text-(--muted) transition-colors hover:text-[#ffb52e]"
          >← tiers</a
        >
        <h1 class="text-2xl md:text-3xl">{title}</h1>
        {
          blurb && (
            <p class="mt-3 max-w-xl text-[15px] leading-[1.85] text-(--text)/90">
              {blurb}
            </p>
          )
        }
      </header>

      {/* the board — sticky on top on phones, sticky alongside on desktop.
          every tile is rendered; the script hides the ones not scrolled to */}
      <aside class="sticky top-16 z-10 -mx-6 bg-[#070707] px-6 pb-4 pt-2 md:top-20 md:-mx-10 md:px-10 lg:order-2 lg:mx-0 lg:self-start lg:px-0 lg:pb-0">
        <div class="border border-black bg-black">
          {tiers.map((tier, tierIndex) => (
            <div class="flex min-h-11 border-b border-black last:border-b-0 lg:min-h-20">
              <div
                class="flex w-11 shrink-0 items-center justify-center p-1 text-center text-sm break-words text-[#1a1a17] lg:w-24 lg:text-xl"
                style={`background:${tierColor(tierIndex)}`}
              >
                {tier}
              </div>
              <div
                data-row
                class="flex flex-1 flex-wrap content-start bg-[#1a1a17] transition-colors data-[over]:bg-[#2c2c28]"
              >
                {items
                  .filter((item) => item.tier === tier)
                  .map((item) => (
                    <button
                      data-chip={item.step}
                      title={item.place ? `${item.name} — ${item.place}` : item.name}
                      class="relative h-11 min-w-11 cursor-grab touch-none overflow-hidden outline-offset-[-2px] select-none hover:opacity-80 active:cursor-grabbing data-[current]:outline-2 data-[current]:outline-white lg:h-20 lg:min-w-20 lg:outline-offset-[-3px] lg:data-[current]:outline-3"
                    >
                      {item.logo ? (
                        // logos keep their shape — full tile height, natural width
                        <Image
                          src={item.logo}
                          alt={item.name}
                          height={160}
                          draggable="false"
                          class="h-full w-auto"
                        />
                      ) : item.photos[0] ? (
                        <Image
                          src={item.photos[0]}
                          alt={item.name}
                          width={160}
                          height={160}
                          draggable="false"
                          class="h-full w-full object-cover"
                        />
                      ) : (
                        <span class="flex h-full w-full items-center justify-center bg-[#2c2c28] p-1 text-center text-[10px] leading-tight text-[#e8e5dd] lg:p-2 lg:text-xs">
                          {item.name}
                        </span>
                      )}
                    </button>
                  ))}
              </div>
            </div>
          ))}
        </div>

        <div class="mt-3 flex items-center justify-between text-xs uppercase tracking-[0.15em] text-(--muted)">
          <span data-counter>{items.length} ranked</span>
          {
            items.length > 0 && (
              <button
                data-show-all
                hidden
                class="transition-colors hover:text-[#ffb52e]"
              >
                show full list
              </button>
            )
          }
        </div>
      </aside>

      {/* the read — one entry after another */}
      <div class="pb-[50vh] lg:order-1">
        {
          items.length === 0 && (
            <p class="py-16 text-[15px] text-(--muted)">nothing ranked yet.</p>
          )
        }
        {items.map((item) => (
          <section
            data-entry={item.step}
            class="scroll-mt-80 border-t border-(--border) py-16 first:border-t-0 first:pt-6 lg:scroll-mt-28 lg:py-24 lg:first:pt-0"
          >
            <div class="mb-6 flex items-center gap-4">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center text-lg text-[#1a1a17]"
                style={`background:${tierColor(tiers.indexOf(item.tier))}`}
              >
                {item.tier}
              </span>
              <div>
                <h2 class="text-xl leading-tight">{item.name}</h2>
                {item.place && (
                  <p class="mt-0.5 text-xs uppercase tracking-[0.15em] text-(--muted)">
                    {item.place}
                  </p>
                )}
              </div>
            </div>

            {item.photos.length > 0 && (
              <div class="-mx-6 mb-6 flex snap-x gap-3 overflow-x-auto px-6 md:-mx-10 md:px-10 lg:mx-0 lg:px-0">
                {item.photos.map((photo, i) => (
                  <Image
                    src={photo}
                    alt={`${item.name}, photo ${i + 1}`}
                    width={640}
                    class="h-56 w-auto max-w-none shrink-0 snap-start border border-(--border) object-cover"
                  />
                ))}
              </div>
            )}

            <div class="space-y-5 text-[15px] leading-[1.85] text-(--text)/90 [&_a]:underline [&_a]:underline-offset-4">
              <item.Content />
            </div>
          </section>
        ))}
      </div>
    </div>

    {/* the board looks draggable. it isn't. (gif from tenor, converted to an
        animated webp at half the size; lazy so it only loads for draggers) */}
    <dialog
      data-nuh-uh
      class="m-auto max-w-[min(28rem,calc(100vw-2rem))] border border-(--border) bg-[#070707] p-0 text-foreground backdrop:bg-black/75"
    >
      <div class="p-4">
        <img
          src="/images/kanye-nuh-uh.webp"
          width="374"
          height="211"
          loading="lazy"
          alt="kanye west: excuse me, was you saying something? uh-uh, you can't tell me nothing"
          class="mb-4 w-full"
        />
        <p class="mb-5 text-sm leading-relaxed">
          excuse me, was you saying something?<br />
          uh-uh, you can't tell me nothing.
        </p>
        <form method="dialog" class="flex justify-end">
          <button class="text-xs uppercase tracking-[0.15em] text-(--muted) transition-colors hover:text-[#ffb52e]">
            my bad
          </button>
        </form>
      </div>
    </dialog>
  </main>
</BaseLayout>

<style>
  /* a tile landing on the board */
  @keyframes drop-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
  [data-chip][data-new] {
    animation: drop-in 300ms cubic-bezier(0.3, 1.5, 0.5, 1);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-tierlist]");
  const sections = [...document.querySelectorAll<HTMLElement>("[data-entry]")];

  if (root && sections.length > 0) {
    const chips = [...root.querySelectorAll<HTMLButtonElement>("[data-chip]")];
    const counter = root.querySelector<HTMLElement>("[data-counter]")!;
    const showAllButton = root.querySelector<HTMLButtonElement>("[data-show-all]")!;
    const total = sections.length;

    // `revealed` = how many entries have scrolled past the reading line;
    // `current` = the one being read right now (outlined on the board)
    let revealed = 0;
    let current = -1;
    let showAll = false;

    const render = () => {
      chips.forEach((chip) => {
        const step = Number(chip.dataset.chip);
        const visible = showAll || step < revealed;
        if (visible && chip.hidden) chip.toggleAttribute("data-new", true);
        if (!visible) chip.removeAttribute("data-new");
        chip.hidden = !visible;
        chip.toggleAttribute("data-current", step === current);
      });
      counter.textContent = showAll
        ? `${total} ranked`
        : `${revealed} / ${total}`;
      showAllButton.hidden = showAll || revealed >= total;
    };

    // an entry counts once its top passes 60% of the way down the screen
    const update = () => {
      const line = window.innerHeight * 0.6;
      const passed = sections.filter((s) => s.getBoundingClientRect().top < line).length;
      if (passed === revealed) return;
      revealed = passed;
      current = passed - 1;
      render();
    };

    let queued = false;
    window.addEventListener(
      "scroll",
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          update();
        });
      },
      { passive: true },
    );
    window.addEventListener("resize", update);

    showAllButton.addEventListener("click", () => {
      showAll = true;
      render();
    });

    // tiles can be picked up and dragged around like a real tier maker — but
    // on release they spring back home and kanye explains why
    const nuhUh = document.querySelector<HTMLDialogElement>("[data-nuh-uh]");
    let draggedAt = 0;

    nuhUh?.addEventListener("click", (event) => {
      if (event.target === nuhUh) nuhUh.close(); // backdrop
    });

    chips.forEach((chip) =>
      chip.addEventListener("pointerdown", (down) => {
        if (down.button !== 0) return;
        let dragging = false;
        let over: HTMLElement | null = null;

        const move = (event: PointerEvent) => {
          const dx = event.clientX - down.clientX;
          const dy = event.clientY - down.clientY;
          if (!dragging && Math.hypot(dx, dy) < 6) return;
          if (!dragging) {
            dragging = true;
            // let elementFromPoint see through the tile to the row beneath
            chip.style.pointerEvents = "none";
            chip.style.zIndex = "20";
            chip.style.transition = "none";
            chip.style.boxShadow = "0 12px 30px rgba(0,0,0,0.6)";
          }
          chip.style.transform = `translate(${dx}px, ${dy}px) scale(1.08) rotate(-3deg)`;

          const row = document
            .elementFromPoint(event.clientX, event.clientY)
            ?.closest<HTMLElement>("[data-row]") ?? null;
          if (row !== over) {
            over?.removeAttribute("data-over");
            row?.setAttribute("data-over", "");
            over = row;
          }
        };

        const up = () => {
          window.removeEventListener("pointermove", move);
          window.removeEventListener("pointerup", up);
          window.removeEventListener("pointercancel", up);
          over?.removeAttribute("data-over");
          if (!dragging) return;

          draggedAt = performance.now();
          chip.style.transition = "transform 350ms cubic-bezier(0.3, 1.5, 0.5, 1), box-shadow 350ms";
          chip.style.transform = "";
          chip.style.boxShadow = "";
          setTimeout(() => (chip.style.cssText = ""), 350);
          if (nuhUh && !nuhUh.open) nuhUh.showModal();
        };

        window.addEventListener("pointermove", move);
        window.addEventListener("pointerup", up);
        window.addEventListener("pointercancel", up);
      }),
    );

    // tapping a tile jumps to its write-up
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        if (performance.now() - draggedAt < 400) return; // that was a drag
        sections[Number(chip.dataset.chip)].scrollIntoView({ behavior: "smooth" });
      }),
    );

    update();
    render();
  }
</script>
