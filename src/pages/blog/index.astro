---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPosts,
  readingTime,
  shortDate,
  year,
  type Post,
} from "../../lib/blog";
// post titles are set in the same serif as the posts themselves
import "@fontsource-variable/newsreader/opsz.css";

// newest first, grouped by year
const posts = await getPosts();
const years = new Map<number, Post[]>();
for (const post of posts) {
  const y = year(post);
  years.set(y, [...(years.get(y) ?? []), post]);
}
---

<BaseLayout title="blog" description="longer writing, every now and then.">
  <main class="min-h-screen bg-[#070707] text-foreground">
    <article class="mx-auto max-w-2xl px-6 pb-32 pt-36 md:px-10 md:pt-44">
      <h1 class="mb-4 text-6xl tracking-loose sm:text-8xl">blog</h1>
      <p class="mb-16 text-xs uppercase tracking-[0.15em] text-(--muted)">
        longer writing, every now and then
      </p>

      {
        posts.length === 0 ? (
          <p class="text-[15px] text-(--muted)">nothing yet. soon.</p>
        ) : (
          [...years].map(([y, list]) => (
            <section class="mb-14 last:mb-0">
              <h2 class="mb-3 font-mono text-xs text-(--muted)">{y}</h2>
              <ol class="border-t border-(--border)">
                {list.map((post) => (
                  <li class="border-b border-(--border)">
                    <a
                      href={`/blog/${post.id}`}
                      class="group flex flex-col gap-1 py-5 sm:flex-row sm:items-baseline sm:gap-6"
                    >
                      <span class="shrink-0 font-mono text-xs text-(--muted) transition-colors group-hover:text-(--accent) sm:w-16">
                        {shortDate(post)}
                      </span>
                      <span class="flex-1 font-['Newsreader_Variable',Georgia,serif] text-[19px] leading-snug text-foreground/90 transition-colors group-hover:text-foreground md:text-[21px]">
                        {post.data.title}
                        {post.data.draft && (
                          <span class="ml-2 font-mono text-xs text-(--accent)">
                            (draft)
                          </span>
                        )}
                      </span>
                      <span class="shrink-0 font-mono text-xs text-(--muted)">
                        {readingTime(post)} min
                      </span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))
        )
      }
    </article>
  </main>
</BaseLayout>
