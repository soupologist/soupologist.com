---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = await getCollection("blog");
---

<BaseLayout title="blog">
  <main class="px-4 md:px-6">
    {/* Top spacing */}
    <div class="pt-20 md:pt-24"></div>

    {/* Main panel */}
    <section
      class="mx-auto max-w-3xl border border-(--border) bg-(--surface) px-5 py-6 md:px-7 md:py-8"
    >
      {/* Header */}
      <div class="mb-8 flex items-end justify-between border-b border-(--border) pb-4">
        <div>
          <p class="mb-2 text-[10px] uppercase tracking-[0.25em] text-foreground opacity-60">
            archive
          </p>

          <h1 class="text-2xl md:text-3xl font-head tracking-widest leading-none">
            blog
          </h1>
        </div>
      </div>

      {/* Posts */}
      <div class="divide-y divide-(--border)">
        {
          posts.map((post, index) => (
            <a href={`/blog/${post.id}`}>
              <article class="group grid grid-cols-[28px_1fr] gap-4 py-4 transition-all duration-200 hover:translate-x-0.5">
                {/* Number */}
                <div class="pt-0.5 text-xs text-foreground opacity-35 group-hover:opacity-80 transition-opacity">
                  {String(index + 1).padStart(2, "0")}
                </div>

                {/* Content */}
                <div>
                  <h2 class="text-lg md:text-xl tracking-tight text-(--text) transition-colors group-hover:text-foreground">
                    {post.data.title}
                  </h2>

                  <p class="mt-1 text-xs text-(--text) opacity-45">
                    {post.data.date}
                  </p>
                </div>
              </article>
            </a>
          ))
        }
      </div>
    </section>

    {/* Bottom spacing */}
    <div class="h-20 md:h-24"></div>
  </main>
</BaseLayout>
