---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const readingTime = Math.max(
  1,
  Math.round((post.body ?? "").split(/\s+/).length / 200),
);

const date = new Date(`${post.data.date}T00:00:00Z`)
  .toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  })
  .toLowerCase();

// same reading column as weeknotes — tailwind's preflight strips list bullets
// and heading sizes, so put back what a post is likely to use
const prose = [
  "space-y-4 text-[14px] leading-[1.8] text-(--text)/90 md:text-[15px]",
  "[&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-(--accent)",
  "[&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:space-y-1.5 [&_ol]:pl-5",
  "[&_li::marker]:text-(--muted)",
  "[&_strong]:font-medium [&_strong]:text-foreground",
  "[&_h1]:mt-12! [&_h1]:mb-1! [&_h1]:text-xl [&_h1]:font-medium [&_h1]:tracking-tight [&_h1]:text-foreground md:[&_h1]:text-2xl",
  "[&_h2]:mt-12! [&_h2]:mb-1! [&_h2]:text-lg [&_h2]:font-medium [&_h2]:tracking-tight [&_h2]:text-foreground md:[&_h2]:text-xl",
  "[&_h3]:mt-10! [&_h3]:mb-2! [&_h3]:text-xs [&_h3]:uppercase [&_h3]:tracking-[0.15em] [&_h3]:text-(--muted)",
  "[&>:first-child]:mt-0!",
  "[&_hr]:my-12! [&_hr]:border-(--border)",
  "[&_img]:my-6 [&_img]:rounded-md [&_img]:border [&_img]:border-(--border)",
  // an *italic line* right under a photo reads as its caption
  "[&_p:has(>img)+p>em:only-child]:block [&_p:has(>img)+p>em:only-child]:-mt-4 [&_p:has(>img)+p>em:only-child]:text-[13px] [&_p:has(>img)+p>em:only-child]:text-(--muted)",
  "[&_blockquote]:border-l [&_blockquote]:border-(--border) [&_blockquote]:pl-4 [&_blockquote]:text-(--text)/70",
  "[&_code]:text-[0.9em] [&_code]:text-(--accent)",
].join(" ");
---

<BaseLayout title={post.data.title}>
  <main class="min-h-screen bg-[#070707] text-foreground">
    <article class="mx-auto max-w-2xl px-6 pb-32 pt-36 md:px-10 md:pt-44">
      <a
        href="/blog"
        class="mb-10 inline-block text-xs uppercase tracking-[0.15em] text-(--muted) transition-colors hover:text-(--accent)"
        >← blog</a
      >

      <header class="mb-14">
        <p class="mb-3 font-mono text-xs text-(--muted)">
          {readingTime} min read
        </p>
        <h1 class="mb-3 text-3xl leading-tight sm:text-4xl">
          {post.data.title}
        </h1>
        <p class="font-mono text-xs text-(--muted)">{date}</p>
      </header>

      <div class={prose}>
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>
