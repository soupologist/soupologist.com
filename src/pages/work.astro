---
import BaseLayout from "../layouts/BaseLayout.astro";

// logos live in public/images/logos/ — trim transparent padding first, then they
// all fit the same 160×44 box (wide wordmarks hit the width, the rest the height)
// `paragraphs` always show; `more` is the longer write-up behind the expand toggle
// (leave it empty and the toggle hides itself)
type Job = {
  company: string;
  role: string;
  location: string;
  dates: string;
  logo: string;
  paragraphs: string[];
  more: string[];
};

const jobs: Job[] = [
  {
    company: "Baya Systems",
    role: "Software Engineer",
    location: "Bengaluru, Karnataka",
    dates: "Jul 2026 — Present",
    logo: "/images/logos/baya-systems.png",
    paragraphs: [
      "My work at Baya is very dynamic, considering that it's an early startup. Our main product is creating NoCs (network-on-chips)",
    ],
    more: [],
  },
  {
    company: "BlackRock",
    role: "Quantitative Analytics Engineering Intern",
    location: "Mumbai, Maharashtra",
    dates: "Jan 2026 — Jun 2026",
    logo: "/images/logos/blackrock.png",
    paragraphs: [
      "Worked on internal tooling for an attribution platform. Built an LLM-powered codebase exploration tool using tree-sitter and Google ADK.",
    ],
    more: ["played a bunch of table tennis."],
  },
  {
    company: "iCIMS",
    role: "Software Engineering Intern",
    location: "Hyderabad, Telangana",
    dates: "May 2025 — Jul 2025",
    logo: "/images/logos/icims.png",
    paragraphs: [
      "Designed and developed a dashboard for fetching data from an internal database.",
    ],
    more: [],
  },
];
---

<BaseLayout title="work">
  <main class="min-h-screen bg-[#070707] text-foreground">
    <article class="mx-auto max-w-2xl px-6 pb-32 pt-36 md:px-10 md:pt-44">
      <h1 class="mb-16 text-3xl tracking-tight sm:text-8xl">w*rk</h1>

      {/* timeline — the rail is the list's left border, dots sit on it */}
      <ol class="ml-1.5 border-l border-(--border)">
        {
          jobs.map((job, index) => (
            <li class="relative pb-14 pl-8 last:pb-0">
              {/* pointy-top hexagon marker, centred on the rail and on the
                  logo's midline (logo is h-11 = 44px → 22px − half of 12px) */}
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class={`absolute left-[-6.5px] top-4 h-3 w-3 ${
                  index === 0
                    ? "fill-[#ffb52e]"
                    : "fill-[#070707] stroke-(--muted)"
                }`}
              >
                <polygon
                  points="12,1.5 21.1,6.75 21.1,17.25 12,22.5 2.9,17.25 2.9,6.75"
                  stroke-width="2"
                  stroke-linejoin="round"
                />
              </svg>

              {/* native <details> so it expands without any JS; the summary
                  is the always-visible card, `more` is what opens up */}
              <details class="group">
                <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden">
                  <img
                    src={job.logo}
                    alt={job.company}
                    class="mb-4 h-11 w-40 object-contain object-left"
                  />

                  <h2 class="mb-3 text-sm text-(--muted)">{job.role}</h2>

                  {job.paragraphs.map((paragraph) => (
                    <p class="mb-4 text-[14px] leading-[1.8] text-(--text)/90 md:text-[15px]">
                      {paragraph}
                    </p>
                  ))}

                  <p class="flex items-center gap-3 text-xs uppercase tracking-[0.15em] text-(--muted)">
                    <span>{job.dates} · {job.location}</span>
                    {job.more.length > 0 && (
                      <span class="ml-auto shrink-0 transition-colors group-hover:text-[#ffb52e]">
                        <span class="group-open:hidden">more +</span>
                        <span class="hidden group-open:inline">less −</span>
                      </span>
                    )}
                  </p>
                </summary>

                {job.more.length > 0 && (
                  <div class="mt-6 border-l border-(--border) pl-5">
                    {job.more.map((paragraph) => (
                      <p class="mb-4 text-[14px] leading-[1.8] text-(--text)/80 last:mb-0 md:text-[15px]">
                        {paragraph}
                      </p>
                    ))}
                  </div>
                )}
              </details>
            </li>
          ))
        }
      </ol>
    </article>
  </main>
</BaseLayout>
