---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// each job is a file in content/work — frontmatter is the header, the body is
// the write-up. newest first, by `start`
const jobs = await Promise.all(
  (await getCollection("work"))
    .sort((a, b) => b.data.start.getTime() - a.data.start.getTime())
    .map(async (entry) => ({
      ...entry.data,
      Content: (await render(entry)).Content,
    })),
);

// tailwind's preflight strips list bullets and heading sizes, so put back
// what a write-up is likely to use
const prose = [
  "space-y-4 text-[14px] leading-[1.8] text-(--text)/90 md:text-[15px]",
  "[&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-[#ffb52e]",
  "[&_ul]:list-disc [&_ul]:space-y-1.5 [&_ul]:pl-5 [&_ol]:list-decimal [&_ol]:space-y-1.5 [&_ol]:pl-5",
  "[&_li::marker]:text-(--muted)",
  "[&_h3]:pt-4 [&_h3]:text-(--text)",
  "[&_img]:my-6 [&_img]:rounded-md [&_img]:border [&_img]:border-(--border)",
  "[&_code]:text-[0.9em] [&_code]:text-[#ffb52e]",
].join(" ");
---

<BaseLayout title="work">
  <main class="min-h-screen bg-[#070707] text-foreground">
    <article class="mx-auto max-w-3xl px-6 pb-32 pt-36 md:px-10 md:pt-44">
      <h1 class="mb-16 text-3xl tracking-tight sm:text-8xl">w*rk</h1>

      {/* timeline — the rail is the list's left border, dots sit on it */}
      <ol class="ml-1.5 border-l border-(--border)">
        {
          jobs.map((job, index) => (
            <li class="relative pb-20 pl-8 last:pb-0">
              {/* pointy-top hexagon marker, centred on the rail and on the
                  logo's midline (logo is h-11 = 44px → 22px − half of 12px) */}
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                class={`absolute left-[-6.5px] top-4 h-3 w-3 ${
                  index === 0
                    ? "fill-[#ffb52e]"
                    : "fill-[#070707] stroke-(--muted)"
                }`}
              >
                <polygon
                  points="12,1.5 21.1,6.75 21.1,17.25 12,22.5 2.9,17.25 2.9,6.75"
                  stroke-width="2"
                  stroke-linejoin="round"
                />
              </svg>

              <img
                src={job.logo}
                alt={job.company}
                class="mb-4 h-11 w-40 object-contain object-left"
              />

              <h2 class="text-sm text-(--text)/90">{job.role}</h2>
              <p class="mb-6 text-[13px] text-(--muted)">
                {job.dates} · {job.location}
              </p>

              <div class={prose}>
                <job.Content />
              </div>
            </li>
          ))
        }
      </ol>
    </article>
  </main>
</BaseLayout>
