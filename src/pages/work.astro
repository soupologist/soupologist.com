---
import BaseLayout from "../layouts/BaseLayout.astro";

// logos live in public/images/logos/ — trim transparent padding first, then they
// all fit the same 160×44 box (wide wordmarks hit the width, the rest the height)
const jobs = [
  {
    company: "Baya Systems",
    role: "Software Engineer",
    location: "Bengaluru, Karnataka",
    dates: "Jul 2026 — Present",
    logo: "/images/logos/baya-systems.png",
    paragraphs: [
      "it's a startup so i just work on whatever's needed. we mainly work on building NoCs for chiplets, using python and C++.",
    ],
  },
  {
    company: "BlackRock",
    role: "Quantitative Analytics Engineering Intern",
    location: "Mumbai, Maharashtra",
    dates: "Jan 2026 — Jun 2026",
    logo: "/images/logos/blackrock.png",
    paragraphs: [
      "Worked on internal tooling for an attribution platform. Built an LLM-powered codebase exploration tool using tree-sitter and Google ADK.",
    ],
  },
  {
    company: "iCIMS",
    role: "Software Engineering Intern",
    location: "Hyderabad, Telangana",
    dates: "May 2025 — Jul 2025",
    logo: "/images/logos/icims.png",
    paragraphs: [
      "Designed and developed a dashboard for fetching data from an internal database.",
    ],
  }
];
---

<BaseLayout title="work">
  <main class="min-h-screen bg-[#070707] text-foreground">
    <article class="mx-auto max-w-2xl px-6 pb-32 pt-36 md:px-10 md:pt-44">
      <h1 class="mb-16 text-3xl tracking-tight sm:text-8xl">w*rk</h1>

      {/* timeline — the rail is the list's left border, dots sit on it */}
      <ol class="ml-1.5 border-l border-(--border)">
        {
          jobs.map((job, index) => (
            <li class="relative pb-14 pl-8 last:pb-0">
              <span
                class={`absolute left-[-5.5px] top-2.5 h-2.5 w-2.5 rounded-full ${
                  index === 0
                    ? "bg-[#ffb52e]"
                    : "border border-(--muted) bg-[#070707]"
                }`}
              />

              <img
                src={job.logo}
                alt={job.company}
                class="mb-4 h-11 w-40 object-contain object-left"
              />

              <h2 class="mb-3 text-sm text-(--muted)">{job.role}</h2>

              {job.paragraphs.map((paragraph) => (
                <p class="mb-4 text-[15px] leading-[1.85] text-(--text)/90 md:text-[16px]">
                  {paragraph}
                </p>
              ))}

              <p class="text-xs uppercase tracking-[0.15em] text-(--muted)">
                {job.dates} · {job.location}
              </p>
            </li>
          ))
        }
      </ol>
    </article>
  </main>
</BaseLayout>
