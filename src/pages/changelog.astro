---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

// what changed on the site, newest first (keepachangelog.com, but dated
// instead of versioned). each day is a file in content/changelog
const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC",
  });

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    id: entry.id,
    date: formatDate(entry.data.date),
    Content: (await render(entry)).Content,
  })),
);

// the ## added / ## changed headings become small labels, each list sits
// under its label
const prose = [
  "text-[15px] leading-[1.85] text-(--text)/80 md:text-[16px]",
  "[&_h2]:mb-2 [&_h2]:mt-8 [&_h2:first-child]:mt-0 [&_h2]:text-xs [&_h2]:uppercase [&_h2]:tracking-[0.15em] [&_h2]:text-(--muted)",
  "[&_ul]:space-y-1 [&_li]:relative [&_li]:pl-5 [&_li]:before:absolute [&_li]:before:left-0 [&_li]:before:text-(--muted) [&_li]:before:content-['–']",
  "[&_a]:underline [&_a]:underline-offset-4",
].join(" ");
---

<BaseLayout title="changelog">
  <main class="min-h-screen bg-[#070707] text-foreground">
    <article class="mx-auto max-w-2xl px-6 pb-32 pt-36 md:px-10 md:pt-44">
      <h1 class="mb-4 text-6xl tracking-loose sm:text-8xl">changelog</h1>
      <h2 class="mb-24 text-xs uppercase tracking-[0.15em] text-(--muted)">
        what's changed around here
      </h2>

      <div class="space-y-20">
        {
          rendered.map(({ id, date, Content }) => (
            <section id={id} class="scroll-mt-32 border-t border-(--border) pt-8">
              <a
                href={`#${id}`}
                class="mb-6 block font-mono text-sm transition-opacity hover:opacity-50"
              >
                {date}
              </a>
              <div class={prose}>
                <Content />
              </div>
            </section>
          ))
        }
      </div>
    </article>
  </main>
</BaseLayout>
